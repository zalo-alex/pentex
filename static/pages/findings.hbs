<page class="finding-page">
    <h2 class="vuln-toc-entry">{{name}}</h2>
    <div class="vuln-header" id="vuln-{{index}}">
        <span>{{name}}</span>
        <span class="vuln-index">FINDING-{{index}}</span>
    </div>

    <table>
        <tr>
            <td class="label-cell">Classification</td>
            <td>{{classification}}</td>
        </tr>
        <tr>
            <td class="label-cell">Severity</td>
            <td>
                <span class="sev-badge sev-{{severityLevel}}">{{severity}}</span>
                {{cvss}}/10.0 &mdash; <a href="https://www.first.org/cvss/calculator/3.1#{{cvssString}}">CVSS Details</a>
            </td>
        </tr>
        <tr>
            <td class="label-cell">Attack Surface</td>
            <td>{{affected}}</td>
        </tr>
        <tr>
            <td class="label-cell">Remediation</td>
            <td>Priority: {{remediationPriority}} &bull; Complexity: {{remediationComplexity}}</td>
        </tr>
    </table>

    <h3>Description</h3>
    {{{description}}}

    <h3>Impact</h3>
    <table>
        <tr>
            <th>Confidentiality</th>
            <th>Integrity</th>
            <th>Availability</th>
        </tr>
        <tr>
            <td>{{cvssImpactText.C}}</td>
            <td>{{cvssImpactText.I}}</td>
            <td>{{cvssImpactText.A}}</td>
        </tr>
    </table>

    <h3>Remediation</h3>
    {{{remediation}}}

    <h3>Proof of Concept</h3>
    {{{poc}}}

    <a href="#vulnerabilities-abstract">Back to findings overview</a>
</page>
