<page class="finding-page">
    <h2 class="vuln-toc-entry">{{name}}</h2>
    <div class="vuln-header" id="vuln-{{index}}">
        <span>{{name}}</span>
        <span class="vuln-index">VULN-{{index}}</span>
    </div>

    <table>
        <tbody>
            <tr>
                <td class="label-cell">Classification</td>
                <td>{{classification}}</td>
            </tr>
            <tr>
                <td class="label-cell">Severity</td>
                <td>
                    <span class="sev-badge sev-{{severityLevel}}">{{severity}}</span>
                    &nbsp; {{cvss}} / 10.0
                    &nbsp;&mdash;&nbsp; <small><a href="https://www.first.org/cvss/calculator/3.1#{{cvssString}}">CVSS Details</a></small>
                </td>
            </tr>
            <tr>
                <td class="label-cell">Attack Surface</td>
                <td>{{affected}}</td>
            </tr>
            <tr>
                <td class="label-cell">Remediation</td>
                <td>Priority: <b>{{remediationPriority}}</b> &nbsp;&bull;&nbsp; Complexity: <b>{{remediationComplexity}}</b></td>
            </tr>
        </tbody>
    </table>

    <h3>Vulnerability Description</h3>
    <div class="text-block">{{{description}}}</div>

    <h3>Impact Analysis</h3>
    <table>
        <thead>
            <tr>
                <th style="text-align: center; width: 33%;">Confidentiality</th>
                <th style="text-align: center; width: 33%;">Integrity</th>
                <th style="text-align: center; width: 33%;">Availability</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="text-align: center; font-weight: 700;">{{cvssImpactText.C}}</td>
                <td style="text-align: center; font-weight: 700;">{{cvssImpactText.I}}</td>
                <td style="text-align: center; font-weight: 700;">{{cvssImpactText.A}}</td>
            </tr>
        </tbody>
    </table>

    <h3>Recommended Remediation</h3>
    <div class="text-block">{{{remediation}}}</div>

    <h3>Technical Evidence &amp; Proof of Concept</h3>
    {{{poc}}}

    <a href="#vulnerabilities-abstract">Back to vulnerability abstract</a>
</page>
