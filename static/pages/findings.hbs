<page class="finding-page">
    <h2 class="vuln-toc-entry">{{name}}</h2>
    <div class="vuln-header" id="vuln-{{index}}">
        <span>{{name}}</span>
        <span class="vuln-index">FINDING-{{index}}</span>
    </div>

    <table>
        <tr>
            <td class="label-cell">Classification</td>
            <td>{{classification}}</td>
        </tr>
        <tr>
            <td class="label-cell">Sévérité</td>
            <td>
                <span class="sev-badge sev-{{severityLevel}}">{{severity}}</span>
                {{cvss}}/10.0 &mdash; <a href="https://www.first.org/cvss/calculator/3.1#{{cvssString}}">Détails CVSS</a>
            </td>
        </tr>
        <tr>
            <td class="label-cell">Surface d'attaque</td>
            <td>{{affected}}</td>
        </tr>
        <tr>
            <td class="label-cell">Remédiation</td>
            <td>Priorité : {{remediationPriority}} &bull; Complexité : {{remediationComplexity}}</td>
        </tr>
    </table>

    <h3>Description</h3>
    {{{description}}}

    {{#if observation}}
    <h3>Observation</h3>
    {{{observation}}}
    {{/if}}

    <h3>Impact</h3>
    <table>
        <tr>
            <th>Confidentialité</th>
            <th>Intégrité</th>
            <th>Disponibilité</th>
        </tr>
        <tr>
            <td>{{cvssImpactText.C}}</td>
            <td>{{cvssImpactText.I}}</td>
            <td>{{cvssImpactText.A}}</td>
        </tr>
    </table>

    <h3>Remédiation</h3>
    {{{remediation}}}

    {{#if references}}
    <h3>Références</h3>
    {{{references}}}
    {{/if}}

    <h3>Preuve de concept</h3>
    {{{poc}}}

    <a href="#vulnerabilities-abstract">Retour à la synthèse des vulnérabilités</a>
</page>
