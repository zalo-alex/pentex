<page no-header no-footer class="title-page">
    <div class="title-cover">
        <img no-figure class="logo-large" src="/static/pages/assets/logo.png">

        <h1 no-index>Penetration Test Report</h1>
        <h2 no-index>{{clientName}} &mdash; {{targetName}}</h2>
        <span class="test-type-label">{{testType}} Assessment</span>
    </div>

    <div class="title-meta">
        <table>
            <tr>
                <th>Issuing Service</th>
                <td>S3/IEC</td>
            </tr>
            <tr>
                <th>Revision</th>
                <td>{{lastVersion}}</td>
            </tr>
            <tr>
                <th>Date of Issue</th>
                <td>{{endOfTestsDate}}</td>
            </tr>
            <tr>
                <th>Classification</th>
                <td>C2 Confidential</td>
            </tr>
            <tr>
                <th>Diffusion</th>
                <td>See diffusion table</td>
            </tr>
        </table>
    </div>
</page>
