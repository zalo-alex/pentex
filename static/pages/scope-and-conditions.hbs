<page class="scope-and-conditions-page">
    <h1>Scope and Conditions</h1>
    
    <h2>Project Timeline</h2>
    <div class="planning-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 2rem;">
        <div class="meta-item">
            <span class="meta-label">Kick-off Meeting</span>
            <span class="meta-value">{{kickOffMeetingDate}}</span>
        </div>
        <div class="meta-item">
            <span class="meta-label">Start of Assessment</span>
            <span class="meta-value">{{startOfTestsDate}}</span>
        </div>
        <div class="meta-item">
            <span class="meta-label">End of Assessment</span>
            <span class="meta-value">{{endOfTestsDate}}</span>
        </div>
    </div>

    <h2>Auditor(s)</h2>
    <table>
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            {{#auditors}}
            <tr>
                <td>{{fullName}}</td>
                <td>{{email}}</td>
            </tr>
            {{/auditors}}
        </tbody>
    </table>

    <h2>Scope</h2>
    <table>
        <thead>
            <tr>
                <th>Target Asset / Perimeter</th>
            </tr>
        </thead>
        <tbody>
            {{#scopes}}
            <tr>
                <td>{{name}}</td>
            </tr>
            {{/scopes}}
        </tbody>
    </table>

    <h2>Provisioned Access</h2>
    <table>
        <thead>
            <tr>
                <th>Identifier</th>
                <th>Role/Type</th>
                <th>Resource</th>
            </tr>
        </thead>
        <tbody>
            {{#testAccess}}
            <tr>
                <td>{{identifier}}</td>
                <td>{{role}}</td>
                <td>{{resource}}</td>
            </tr>
            {{/testAccess}}
        </tbody>
    </table>

    {{#if strength}}
    <h2>Security Strengths</h2>
    <div class="text-block">{{strength}}</div>
    {{/if}}

    {{#if reserves}}
    <h2>Limitations &amp; Constraints</h2>
    <div class="text-block">{{reserves}}</div>
    {{/if}}

    {{#if discoveryApplication}}
    <h2>Application Discovery Findings</h2>
    <div class="text-block">{{discoveryApplication}}</div>
    {{/if}}

    {{#if discoveryInfra}}
    <h2>Infrastructure Discovery Findings</h2>
    <div class="text-block">{{discoveryInfra}}</div>
    {{/if}}

    {{#if (or account injection upload traces)}}
    <h2>Audit Artifacts &amp; Traces</h2>
    {{/if}}

    {{#if account}}
    <h3>Created Accounts</h3>
    <p>{{account}}</p>
    {{/if}}

    {{#if injection}}
    <h3>Security Injections</h3>
    <p>{{injection}}</p>
    {{/if}}

    {{#if upload}}
    <h3>Uploaded Files</h3>
    <p>{{upload}}</p>
    {{/if}}

    {{#if traces}}
    <h3>Miscellaneous Traces</h3>
    <p>{{traces}}</p>
    {{/if}}
</page>
