<page class="acronyms-page">
    <h1 no-index>Acronyms &amp; Definitions</h1>
    <table>
        <tr>
            <th>Acronym</th>
            <th>Definition</th>
        </tr>
        {{#abbreviations}}
        <tr>
            <td>{{abbreviation}}</td>
            <td>{{definition}}</td>
        </tr>
        {{/abbreviations}}
    </table>
</page>
