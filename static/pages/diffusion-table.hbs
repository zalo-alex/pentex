<page no-page-break class="diffusion-table-page">
    <h1 no-index>Table de diffusion</h1>
    <table>
        <tr>
            <th>Société</th>
            <th>Nom</th>
            <th>Rôle</th>
            <th>Email</th>
        </tr>
        {{#diffusionTable}}
        <tr>
            <td>{{company}}</td>
            <td>{{name}}</td>
            <td>{{role}}</td>
            <td>{{email}}</td>
        </tr>
        {{/diffusionTable}}
    </table>
</page>
