<page no-page-break class="diffusion-table-page">
    <h1 no-index>Diffusion Table</h1>
    <table>
        <tr>
            <th>Company</th>
            <th>Name</th>
            <th>Role</th>
            <th>Email</th>
        </tr>
        {{#diffusionTable}}
        <tr>
            <td>{{company}}</td>
            <td>{{name}}</td>
            <td>{{role}}</td>
            <td>{{email}}</td>
        </tr>
        {{/diffusionTable}}
    </table>
</page>
