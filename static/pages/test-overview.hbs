<page class="test-overview-page">
    <h1>Vue d'ensemble des tests</h1>
    <p>Référentiel : Web Security Testing Guide (WSTG), OWASP.</p>
    {{#each wstgCategories}}
    <h2>4.{{num}} &mdash; {{name}}</h2>
    <table>
        <tr>
            <th>Test</th>
            <th>Nom</th>
            <th>Testé</th>
            <th>Vulnérabilité</th>
        </tr>
        {{#each tests}}
        <tr>
            <td>{{id}}</td>
            <td>{{name}}</td>
            <td class="wstg-mark">{{#if tested}}✔{{else}}&mdash;{{/if}}</td>
            <td class="wstg-vuln-cell">
                {{#if vulnFindings}}
                {{#each vulnFindings}}<a href="#vuln-{{index}}">VULN-{{index}}</a>{{#unless @last}}, {{/unless}}{{/each}}
                {{else}}
                &mdash;
                {{/if}}
            </td>
        </tr>
        {{/each}}
    </table>
    {{{proof}}}
    {{/each}}
</page>
