<page class="executive-summary-page">
    <h1>Résumé exécutif</h1>

    <h2>Synthèse</h2>
    <p>Une évaluation de sécurité de type {{testType}} de <b>{{targetName}}</b> a été réalisée sur son environnement {{env}}.</p>

    {{#if securityLevel}}
    <p>Le niveau de sécurité global de <b>{{targetName}}</b> est évalué comme <span class="sev-badge sev-{{securityLevel}}">{{securityLevel}}</span>.</p>
    {{/if}}

    {{#if risks}}
    <h2>Risques</h2>
    {{{risks}}}
    {{/if}}

    {{#if actionPlan}}
    <h2>Plan d'action</h2>
    {{{actionPlan}}}
    {{/if}}

    <h2>Synthèse des vulnérabilités</h2>
    <table id="vulnerabilities-abstract">
        <tr>
            <th>Vulnérabilité</th>
            <th>Sévérité</th>
        </tr>
        {{#findings}}
        <tr>
            <td><a href="#vuln-{{index}}">{{name}}</a></td>
            <td>{{cvss}}/10.0 <span class="sev-badge sev-{{severityLevel}}">{{severity}}</span></td>
        </tr>
        {{/findings}}
    </table>
</page>
