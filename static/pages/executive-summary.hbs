<page class="executive-summary-page">
    <h1>Executive Summary</h1>

    <h2>Summary</h2>
    <p>A {{testType}} security assessment of <b>{{targetName}}</b> was carried out against its {{env}} environment.</p>

    {{#if securityLevel}}
    <p>The overall security level of <b>{{targetName}}</b> is assessed as <span class="sev-badge sev-{{securityLevel}}">{{securityLevel}}</span>.</p>
    {{/if}}

    {{#if risks}}
    <h2>Risks</h2>
    {{{risks}}}
    {{/if}}

    {{#if actionPlan}}
    <h2>Action Plan</h2>
    {{{actionPlan}}}
    {{/if}}

    <h2>Findings Overview</h2>
    <table id="vulnerabilities-abstract">
        <tr>
            <th>Finding</th>
            <th>Severity</th>
        </tr>
        {{#findings}}
        <tr>
            <td><a href="#vuln-{{index}}">{{name}}</a></td>
            <td>{{cvss}}/10.0 <span class="sev-badge sev-{{severityLevel}}">{{severity}}</span></td>
        </tr>
        {{/findings}}
    </table>
</page>
